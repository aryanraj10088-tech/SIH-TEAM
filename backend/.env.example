# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/srijansetu

# Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Admin Seeding
ADMIN_EMAIL=admin@srijansetu.com
ADMIN_PASSWORD=securepassword123

# Test Operator Seeding
TEST_OPERATOR_EMAIL=operator@srijansetu.com
TEST_OPERATOR_PASSWORD=operatorpassword123

# Cloud Storage Configuration (S3-Compatible)
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=my-srijansetu-bucket
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
