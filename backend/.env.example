# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (used for CORS, Google OAuth redirect, email links)
# Local dev:
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://your-app.vercel.app

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/srijansetu

# Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Admin Seeding
ADMIN_EMAIL=admin@srijansetu.com
ADMIN_PASSWORD=securepassword123

# Test Operator Seeding
TEST_OPERATOR_EMAIL=operator@srijansetu.com
TEST_OPERATOR_PASSWORD=operatorpassword123

# Cloud Storage Configuration (S3-Compatible)
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=my-srijansetu-bucket
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# Email Configuration (SMTP — used for reviewer invitations & workflow notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@srijansetu.com

# Brevo (Sendinblue) REST API — optional, used as email sending backend
# If set, Brevo API is used; otherwise falls back to SMTP above.
# BREVO_API_KEY=your_brevo_api_key_here

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Obtain these from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID of type "Web application"
#
# Authorized redirect URIs to register in Google Cloud Console:
#   Local dev:   http://localhost:5000/api/auth/google/callback
#   Production:  https://your-backend.onrender.com/api/auth/google/callback
#
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Set to the backend callback URL for the current environment:
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Production: GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback
